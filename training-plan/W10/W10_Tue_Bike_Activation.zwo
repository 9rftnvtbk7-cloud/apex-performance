<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W10 Tue – Leg Activation</name>
  <description>35min. 10min easy → 3×4min @ Z3-Z4 (178-194W) with 4min Z1 between → 7min easy. Wake legs up without fatiguing them.</description>
