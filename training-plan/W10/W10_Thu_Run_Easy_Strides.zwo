<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W10 Thu – Easy Run + Strides</name>
  <description>25min. 20min easy (&gt;6:45/km) → 4×15sec strides with full walk recovery. Legs should feel light and quick. Last run before race.</description>
  <sportType>run</sportType>
  <tags/>
  <workout>
    <Warmup Duration="300" PaceLow="2.350" PaceHigh="2.470"/>
    <SteadyState Duration="900" Pace="2.350"/>
    <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPace="3.330" OffPace="1.500"/>
    <Cooldown Duration="180" PaceLow="2.470" PaceHigh="2.350"/>
  </workout>
</workout_file>