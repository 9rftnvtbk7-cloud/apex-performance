<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W04 Tue – VO2max 5×4min</name>
  <description>60min. 15min warmup (incl. 3×1min Z4 primers at 3min, 7min, 11min) → 5×4min @ Z5 (196-217W) with 4min Z1 recovery → 13min cooldown. Very hard — shorten to 3min if power drops below 194W in reps 4-5.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="180" PowerLow="0.500" PowerHigh="0.750"/>
    <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="0.880" OffPower="0.500"/>
    <SteadyState Duration="180" Power="0.500"/>
    <IntervalsT Repeat="5" OnDuration="240" OffDuration="240" OnPower="1.010" OffPower="0.500"/>
    <Cooldown Duration="780" PowerLow="0.760" PowerHigh="0.500"/>
  </workout>
</workout_file>