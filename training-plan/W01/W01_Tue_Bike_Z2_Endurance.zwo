<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W01 Tue – Z2 Endurance</name>
  <description>60min aerobic base. 10min warmup, 40min Z2 (114-153W), 10min cooldown. First session at corrected FTP=205W zones.</description>
