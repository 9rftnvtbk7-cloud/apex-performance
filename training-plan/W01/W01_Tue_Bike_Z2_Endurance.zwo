    <Warmup Duration="600" PowerLow="0.500" PowerHigh="0.650"/>
    <SteadyState Duration="2400" Power="0.650"/>
    <Cooldown Duration="600" PowerLow="0.650" PowerHigh="0.500"/>
  </workout>
</workout_file>