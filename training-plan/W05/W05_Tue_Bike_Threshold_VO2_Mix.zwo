<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W05 Tue – Threshold/VO2 Mix</name>
  <description>60min. 12min warmup → 2×8min @ Z4 (180-194W) with 4min Z1 → 3×3min @ Z5 (196-217W) with 4min Z1 → 14min cooldown. Mixed intensity mirrors late-race demands.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="720" PowerLow="0.500" PowerHigh="0.820"/>
    <IntervalsT Repeat="2" OnDuration="480" OffDuration="240" OnPower="0.920" OffPower="0.500"/>
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="240" OnPower="1.010" OffPower="0.500"/>
    <Cooldown Duration="840" PowerLow="0.820" PowerHigh="0.500"/>
  </workout>
</workout_file>