<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W03 Tue – Threshold 3×10min</name>
  <description>60min. 12min warmup → 3×10min @ Z4 (180-194W) with 5min Z1 recovery → 13min cooldown. Core FTP-building session.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="720" PowerLow="0.500" PowerHigh="0.820"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.920" OffPower="0.500"/>
    <Cooldown Duration="780" PowerLow="0.820" PowerHigh="0.500"/>
  </workout>
</workout_file>