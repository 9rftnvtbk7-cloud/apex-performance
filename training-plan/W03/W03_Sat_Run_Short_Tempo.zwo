<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W03 Sat – Short Tempo Run</name>
  <description>28min. 8min easy warmup → 12min @ Z3 tempo (6:05-6:25/km) → 8min easy cooldown. Two quality run sessions this week. No strength (Week 1-3 = one strength session only).</description>
  <sportType>run</sportType>
  <tags/>
  <workout>
    <Warmup Duration="480" PaceLow="2.350" PaceHigh="2.560"/>
    <SteadyState Duration="720" Pace="2.670"/>
    <Cooldown Duration="480" PaceLow="2.560" PaceHigh="2.350"/>
  </workout>
</workout_file>