<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W02 Thu – Aerobic Run + Strides</name>
  <description>50min. 42min easy @ Z1/Z2 (&gt;6:45/km, &lt;137bpm). Then 4×15sec strides with full walk recovery. Strides = brief accelerations to ~80% top speed, not sprints. Walk fully between each.</description>
  <sportType>run</sportType>
  <tags/>
  <workout>
    <SteadyState Duration="2520" Pace="2.350"/>
    <IntervalsT Repeat="4" OnDuration="15" OffDuration="45" OnPace="3.330" OffPace="1.500"/>
    <SteadyState Duration="180" Pace="2.350"/>
  </workout>
</workout_file>