<?xml version="1.0" encoding="utf-8"?>
<workout_file>
  <author>Tristan Training Plan v5</author>
  <name>W08 Thu – Threshold 6×800m</name>
  <description>55min. 10min easy warmup → 6×800m @ Z4 (5:35-5:55/km) with 90sec easy jog recovery → 15min easy cooldown. Shorter, sharper reps than Week 6 — race-sharpening. 800m at target pace = ~275-285sec.</description>
  <sportType>run</sportType>
  <tags/>
  <workout>
    <Warmup Duration="600" PaceLow="2.350" PaceHigh="2.560"/>
    <IntervalsT Repeat="6" OnDuration="278" OffDuration="90" OnPace="2.940" OffPace="2.200"/>
    <Cooldown Duration="900" PaceLow="2.560" PaceHigh="2.350"/>
  </workout>
</workout_file>