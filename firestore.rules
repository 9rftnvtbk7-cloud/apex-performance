rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Activities: each user has a subcollection
    match /users/{userId}/activities/{activityId} {
      allow read, write: if isOwner(userId);
    }

    // Settings: each user has their own settings doc
    match /users/{userId}/settings/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Planner data
    match /users/{userId}/planner/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Training plan data (plan/current, plan/current_part_N, completions, raceDates, zwo_files)
    match /users/{userId}/plan/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Daily wellness log, one document per date (YYYY-MM-DD)
    match /users/{userId}/wellness/{dateId} {
      allow read, write: if isOwner(userId) && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
  }
}
